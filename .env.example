# Telegram Bot Token (BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram API credentials (my.telegram.org)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Vaqtinchalik fayllar papkasi
DOWNLOAD_DIR=downloads

# Render.com porti
PORT=8080

# Render <-> Lokal navbat almashish (lokal bot yoqilganda Render vaqtincha to'xtaydi)
# RENDER_URL faqat lokal .env da kerak
RENDER_URL=https://your-service.onrender.com
# Render Environment va lokal .env da BIR XIL bo'lishi shart
HANDOFF_SECRET=uzun_tasodifiy_maxfiy_kalit
